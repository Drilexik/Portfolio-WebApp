#!/usr/bin/env bash
#
# redeploywebapp — pull the latest code and redeploy the Drilex portfolio
#                  into Docker on an Ubuntu host.
#
# Repo: https://github.com/Drilexik/Portfolio-WebApp
#
# Usage:
#   ./redeploywebapp              Pull latest, rebuild images, restart containers
#   ./redeploywebapp --no-pull    Skip 'git pull' — rebuild from the local code
#   ./redeploywebapp --no-cache   Rebuild images from scratch (no Docker cache)
#   ./redeploywebapp --logs       Follow the app logs after deploying
#   ./redeploywebapp -h | --help  Show this help
#
set -euo pipefail

REPO_URL="https://github.com/Drilexik/Portfolio-WebApp.git"

# Run from the directory this script lives in, regardless of the caller's CWD.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ── Pretty output ────────────────────────────────────────────────
log()  { printf '\033[1;35m▸ %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$*"; }
err()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }

usage() { sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'; }

# ── Parse arguments ──────────────────────────────────────────────
PULL=1
NO_CACHE=0
FOLLOW_LOGS=0
for arg in "$@"; do
  case "$arg" in
    --no-pull)  PULL=0 ;;
    --no-cache) NO_CACHE=1 ;;
    --logs)     FOLLOW_LOGS=1 ;;
    -h|--help)  usage; exit 0 ;;
    *) err "Unknown option: $arg"; usage; exit 1 ;;
  esac
done

# ── Pre-flight checks ────────────────────────────────────────────
command -v git >/dev/null 2>&1 || { err "git is not installed."; exit 1; }

# Detect Compose flavour: 'docker compose' (v2 plugin) or 'docker-compose' (v1).
if docker compose version >/dev/null 2>&1; then
  DC=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  DC=(docker-compose)
else
  err "Docker Compose not found. Install Docker Engine and the Compose plugin."
  exit 1
fi

# Make sure the Docker daemon is reachable (running + permissions ok).
if ! docker info >/dev/null 2>&1; then
  err "Cannot reach the Docker daemon. Is it running, and is your user in the 'docker' group (or run with sudo)?"
  exit 1
fi

# docker-compose.yml reads secrets from .env — refuse to deploy without it.
if [[ ! -f .env ]]; then
  err ".env not found in $SCRIPT_DIR"
  warn "Create it first:  cp .env.example .env  &&  nano .env"
  exit 1
fi

# ── 1. Pull the latest code ──────────────────────────────────────
if [[ $PULL -eq 1 ]]; then
  if [[ -d .git ]]; then
    BRANCH="$(git rev-parse --abbrev-ref HEAD)"
    log "Pulling latest changes on '$BRANCH' from $REPO_URL"
    git fetch --prune origin
    if ! git pull --ff-only origin "$BRANCH"; then
      err "Fast-forward pull failed — your local branch has diverged from origin."
      warn "Resolve it manually, or re-run with --no-pull to deploy local code."
      exit 1
    fi
  else
    warn "Not a git repository — skipping pull. Deploying local code as-is."
  fi
else
  warn "--no-pull set — skipping 'git pull'."
fi

# ── 2. Build the images ──────────────────────────────────────────
BUILD_ARGS=(build --pull)
[[ $NO_CACHE -eq 1 ]] && BUILD_ARGS+=(--no-cache)

log "Building Docker images…"
"${DC[@]}" "${BUILD_ARGS[@]}"

# ── 3. Restart the stack ─────────────────────────────────────────
log "Starting / restarting containers…"
"${DC[@]}" up -d --remove-orphans

# ── 4. Clean up dangling images from previous builds ─────────────
log "Pruning dangling images…"
docker image prune -f >/dev/null 2>&1 || true

# ── 5. Report status ─────────────────────────────────────────────
ok "Deployment complete."
"${DC[@]}" ps

if [[ $FOLLOW_LOGS -eq 1 ]]; then
  log "Following app logs (Ctrl-C to stop)…"
  "${DC[@]}" logs -f app
fi
