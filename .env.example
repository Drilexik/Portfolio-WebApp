# ─── Server ───────────────────────────────────────────────
# Host port exposed on the VPS (defaults to 5000)
PORT=5000

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=drilex
POSTGRES_USER=drilex
POSTGRES_PASSWORD=supersecretpassword

# ─── Admin Panel ──────────────────────────────────────────
ADMIN_PASSWORD=changeme_before_deploy

# ─── Next.js ──────────────────────────────────────────────
# Must be set for production builds
NEXTAUTH_URL=http://localhost:5000
