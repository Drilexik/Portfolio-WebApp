#!/usr/bin/env bash
#
# deploywebapp — first-time setup for the Drilex portfolio on an Ubuntu host.
#
# Interactively builds the .env file (so you never edit it by hand), then
# builds and starts the full Docker stack (app + PostgreSQL).
#
# Repo: https://github.com/Drilexik/Portfolio-WebApp
#
# Usage:
#   ./deploywebapp              Interactive first-time setup + deploy
#   ./deploywebapp -h | --help  Show this help
#
# For routine updates afterwards, use ./redeploywebapp instead.
#
set -euo pipefail

# Run from the directory this script lives in, regardless of the caller's CWD.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ── Pretty output ────────────────────────────────────────────────
log()  { printf '\033[1;35m▸ %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$*"; }
err()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }
hr()   { printf '\033[2m%s\033[0m\n' "────────────────────────────────────────────────────────"; }

usage() { sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) err "Unknown option: $1"; usage; exit 1 ;;
esac

# Interactive prompts need a real terminal.
if [[ ! -t 0 ]]; then
  err "This script is interactive — run it directly in a terminal (./deploywebapp)."
  exit 1
fi

# ── Helpers ──────────────────────────────────────────────────────
gen_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  else
    head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
  fi
}

# ask VAR "Prompt" "default"   → plain text with optional default
ask() {
  local __var=$1 prompt=$2 default=${3:-} input
  if [[ -n "$default" ]]; then
    read -rp "  ${prompt} [${default}]: " input
    input=${input:-$default}
  else
    while :; do
      read -rp "  ${prompt}: " input
      [[ -n "$input" ]] && break
      warn "  this value is required"
    done
  fi
  printf -v "$__var" '%s' "$input"
}

# ask_secret VAR "Prompt"   → hidden input; blank = auto-generate.
#   Sets <VAR>_GENERATED=1 when the value was auto-generated.
ask_secret() {
  local __var=$1 prompt=$2 input confirm
  while :; do
    read -rsp "  ${prompt} (leave blank to auto-generate): " input; echo
    if [[ -z "$input" ]]; then
      input=$(gen_secret)
      printf -v "${__var}_GENERATED" '%s' "1"
      ok "  auto-generated"
      break
    fi
    read -rsp "  confirm: " confirm; echo
    if [[ "$input" == "$confirm" ]]; then
      printf -v "${__var}_GENERATED" '%s' "0"
      break
    fi
    warn "  values didn't match — try again"
  done
  printf -v "$__var" '%s' "$input"
}

# ── 0. Prerequisites ─────────────────────────────────────────────
hr; log "Checking prerequisites…"; hr

if ! command -v docker >/dev/null 2>&1; then
  warn "Docker is not installed."
  read -rp "  Install Docker now via the official script (get.docker.com)? [y/N]: " yn
  if [[ "${yn,,}" == "y" || "${yn,,}" == "yes" ]]; then
    log "Installing Docker…"
    curl -fsSL https://get.docker.com | sh
    systemctl enable --now docker 2>/dev/null || true
  else
    err "Docker is required. Install it, then re-run ./deploywebapp"
    exit 1
  fi
fi

# Detect Compose flavour: 'docker compose' (v2) or 'docker-compose' (v1).
if docker compose version >/dev/null 2>&1; then
  DC=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  DC=(docker-compose)
else
  err "Docker Compose not found. Install the Docker Compose plugin and re-run."
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  err "Cannot reach the Docker daemon. Is it running, and is your user in the 'docker' group (or run with sudo)?"
  exit 1
fi
ok "Docker $(docker --version | awk '{print $3}' | tr -d ',') and Compose are ready."

# ── 1. .env handling ─────────────────────────────────────────────
if [[ -f .env ]]; then
  hr; warn ".env already exists in $SCRIPT_DIR"
  read -rp "  Overwrite it with new values? [y/N]: " yn
  if [[ "${yn,,}" != "y" && "${yn,,}" != "yes" ]]; then
    log "Keeping the existing .env — skipping straight to deploy."
    SKIP_ENV=1
  fi
fi

if [[ -z "${SKIP_ENV:-}" ]]; then
  hr; log "Let's configure your environment (.env)."
  printf '\033[2m  Press Enter to accept the [default]. Secrets can be auto-generated.\033[0m\n\n'

  ask        PORT              "Public port to expose the site on"  "5000"
  ask        POSTGRES_DB       "PostgreSQL database name"           "drilex"
  ask        POSTGRES_USER     "PostgreSQL user"                    "drilex"
  ask_secret POSTGRES_PASSWORD "PostgreSQL password"
  echo
  ask_secret ADMIN_PASSWORD    "Admin panel password (/admin login)"
  echo
  log "Session secret signs the admin login cookie — auto-generating is recommended."
  ask_secret SESSION_SECRET    "Session secret"

  # POSTGRES_HOST is fixed to the compose service name 'db'; POSTGRES_PORT
  # stays at the default unless you have a reason to change it.
  POSTGRES_PORT="5432"

  log "Writing .env…"
  umask 077   # create the file as 0600 (owner read/write only)
  {
    printf '# Generated by ./deploywebapp on %s — do not commit.\n\n' "$(date -u '+%Y-%m-%d %H:%M UTC')"
    printf 'PORT=%s\n\n' "$PORT"
    printf 'POSTGRES_HOST=db\n'
    printf 'POSTGRES_PORT=%s\n' "$POSTGRES_PORT"
    printf 'POSTGRES_DB=%s\n' "$POSTGRES_DB"
    printf 'POSTGRES_USER=%s\n' "$POSTGRES_USER"
    printf 'POSTGRES_PASSWORD=%s\n\n' "$POSTGRES_PASSWORD"
    printf 'ADMIN_PASSWORD=%s\n' "$ADMIN_PASSWORD"
    printf 'SESSION_SECRET=%s\n' "$SESSION_SECRET"
  } > .env
  chmod 600 .env
  ok ".env written (permissions 600)."
fi

# ── 2. Build & launch ────────────────────────────────────────────
hr; log "Building images and starting the stack (this can take a few minutes)…"; hr
"${DC[@]}" up -d --build --remove-orphans

# ── 3. Summary ───────────────────────────────────────────────────
hr; ok "Deployment complete."; hr
"${DC[@]}" ps

PORT_OUT="$( (grep -E '^PORT=' .env || true) | cut -d= -f2- )"; PORT_OUT="${PORT_OUT:-5000}"
IP="$(hostname -I 2>/dev/null | awk '{print $1}')"; IP="${IP:-<server-ip>}"

echo
log "Your site:        http://${IP}:${PORT_OUT}"
log "Admin panel:      http://${IP}:${PORT_OUT}/admin"
echo

# Surface auto-generated credentials once, so they aren't lost. They are also
# saved in .env (chmod 600). The session secret never needs to be typed again.
if [[ "${ADMIN_PASSWORD_GENERATED:-0}" == "1" ]]; then
  warn "Auto-generated ADMIN password (save this — needed to log in to /admin):"
  printf '      \033[1m%s\033[0m\n' "$ADMIN_PASSWORD"
fi
if [[ "${POSTGRES_PASSWORD_GENERATED:-0}" == "1" ]]; then
  warn "Auto-generated PostgreSQL password (stored in .env):"
  printf '      \033[1m%s\033[0m\n' "$POSTGRES_PASSWORD"
fi

echo
log "To update the app later, run:  ./redeploywebapp"
